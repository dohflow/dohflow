{
  "protocol": "dohflow-sync-service",
  "protocol_version": 1,
  "document": "docs/architecture/sync-service-protocol.md",
  "operations": [
    {
      "op": "getInfo",
      "method": "GET",
      "path": "/info",
      "auth": "none",
      "success": "200",
      "errors": []
    },
    {
      "op": "getStatus",
      "method": "GET",
      "path": "/vaults/{vault_id}/status",
      "auth": "device",
      "success": "200",
      "errors": [
        "VaultNotFound"
      ]
    },
    {
      "op": "getChain",
      "method": "GET",
      "path": "/vaults/{vault_id}/chain",
      "auth": "device",
      "success": "200",
      "errors": [
        "VaultNotFound"
      ]
    },
    {
      "op": "installEpoch",
      "method": "POST",
      "path": "/vaults/{vault_id}/epochs",
      "auth": "account/device",
      "success": "201/200",
      "errors": [
        "VaultExists",
        "VaultNotFound",
        "ReplicaHalted",
        "WritesSuspended",
        "MembershipChainInvalid",
        "EpochRecordInvalid",
        "EpochRecordMissing",
        "CutoverHeadNotRevoke",
        "GrantHeadNotAdd",
        "BadEpochSequence",
        "KeyCommitmentMismatch",
        "StaleMembershipHead",
        "HeadMismatch",
        "SnapshotNotFound",
        "ArtifactMissing",
        "QuotaExceeded",
        "MalformedObject",
        "UnsupportedSuite"
      ]
    },
    {
      "op": "claimCredential",
      "method": "POST",
      "path": "/vaults/{vault_id}/devices/{device_id}/credential",
      "auth": "account",
      "success": "200",
      "errors": [
        "VaultNotFound",
        "DeviceNotFound",
        "ClaimProofInvalid"
      ]
    },
    {
      "op": "pushEnvelopes",
      "method": "POST",
      "path": "/vaults/{vault_id}/envelopes",
      "auth": "device",
      "success": "200",
      "errors": [
        "VaultNotFound",
        "WritesSuspended",
        "MalformedObject",
        "UnsupportedSuite",
        "ProtocolFork",
        "EpochRejected",
        "ArtifactMissing",
        "NonceTupleReused",
        "HeadMismatch",
        "QuotaExceeded",
        "PayloadTooLarge"
      ]
    },
    {
      "op": "pullEnvelopes",
      "method": "GET",
      "path": "/vaults/{vault_id}/envelopes",
      "auth": "device",
      "success": "200",
      "errors": [
        "VaultNotFound",
        "TailTruncated"
      ]
    },
    {
      "op": "ack",
      "method": "POST",
      "path": "/vaults/{vault_id}/acks",
      "auth": "device",
      "success": "200",
      "errors": [
        "VaultNotFound",
        "AckBeyondHead"
      ]
    },
    {
      "op": "stageSnapshot",
      "method": "PUT",
      "path": "/vaults/{vault_id}/snapshots/{snapshot_id}",
      "auth": "account/device",
      "success": "201/200",
      "errors": [
        "VaultNotFound",
        "ReplicaHalted",
        "WritesSuspended",
        "PayloadTooLarge",
        "MalformedObject",
        "UnsupportedSuite",
        "EpochRejected",
        "NonceTupleReused",
        "ObjectConflict",
        "SnapshotTooLarge",
        "QuotaExceeded"
      ]
    },
    {
      "op": "publishSnapshot",
      "method": "POST",
      "path": "/vaults/{vault_id}/snapshots/{snapshot_id}/publish",
      "auth": "device",
      "success": "200",
      "errors": [
        "VaultNotFound",
        "ReplicaHalted",
        "WritesSuspended",
        "SnapshotNotFound",
        "MalformedObject",
        "EpochRejected",
        "HeadMismatch",
        "ArtifactMissing",
        "QuotaExceeded"
      ]
    },
    {
      "op": "getLatestSnapshot",
      "method": "GET",
      "path": "/vaults/{vault_id}/snapshots/latest",
      "auth": "device",
      "success": "200",
      "errors": [
        "VaultNotFound",
        "SnapshotNotFound"
      ]
    },
    {
      "op": "getSnapshot",
      "method": "GET",
      "path": "/vaults/{vault_id}/snapshots/{snapshot_id}",
      "auth": "device",
      "success": "200",
      "errors": [
        "VaultNotFound",
        "SnapshotNotFound"
      ]
    },
    {
      "op": "putArtifact",
      "method": "PUT",
      "path": "/vaults/{vault_id}/artifacts/{artifact_id}",
      "auth": "account/device",
      "success": "201/200",
      "errors": [
        "VaultNotFound",
        "WritesSuspended",
        "MalformedObject",
        "EpochRejected",
        "ObjectConflict",
        "PayloadTooLarge",
        "QuotaExceeded"
      ]
    },
    {
      "op": "getArtifact",
      "method": "GET",
      "path": "/vaults/{vault_id}/artifacts/{artifact_id}",
      "auth": "device",
      "success": "200",
      "errors": [
        "VaultNotFound",
        "ArtifactNotFound"
      ]
    },
    {
      "op": "getArtifactStatus",
      "method": "POST",
      "path": "/vaults/{vault_id}/artifacts/status",
      "auth": "device",
      "success": "200",
      "errors": [
        "VaultNotFound"
      ]
    },
    {
      "op": "appendVoid",
      "method": "POST",
      "path": "/vaults/{vault_id}/voids",
      "auth": "device",
      "success": "201/200",
      "errors": [
        "VaultNotFound",
        "WritesSuspended",
        "MalformedObject",
        "UnsupportedSuite",
        "VoidSignerNotAuthorized",
        "VoidSignatureInvalid",
        "VoidTargetMismatch",
        "QuotaExceeded"
      ]
    },
    {
      "op": "reportHalt",
      "method": "PUT",
      "path": "/vaults/{vault_id}/devices/{device_id}/halt",
      "auth": "device",
      "success": "200",
      "errors": [
        "VaultNotFound"
      ]
    },
    {
      "op": "beginSnapshotUpload",
      "method": "POST",
      "path": "/vaults/{vault_id}/snapshots/{snapshot_id}/uploads",
      "auth": "account/device",
      "success": "201/200",
      "errors": [
        "VaultNotFound",
        "ReplicaHalted",
        "WritesSuspended",
        "SnapshotTooLarge",
        "PayloadTooLarge",
        "ObjectConflict",
        "QuotaExceeded"
      ]
    },
    {
      "op": "putSnapshotPart",
      "method": "PUT",
      "path": "/vaults/{vault_id}/snapshots/{snapshot_id}/uploads/parts/{part_number}",
      "auth": "account/device",
      "success": "201/200",
      "errors": [
        "VaultNotFound",
        "ReplicaHalted",
        "WritesSuspended",
        "UploadNotFound",
        "PartOutOfSequence",
        "ObjectConflict",
        "MalformedObject",
        "UnsupportedSuite",
        "EpochRejected",
        "PayloadTooLarge"
      ]
    },
    {
      "op": "completeSnapshotUpload",
      "method": "POST",
      "path": "/vaults/{vault_id}/snapshots/{snapshot_id}/uploads/complete",
      "auth": "account/device",
      "success": "201/200",
      "errors": [
        "VaultNotFound",
        "ReplicaHalted",
        "WritesSuspended",
        "UploadNotFound",
        "UploadIncomplete",
        "MalformedObject",
        "EpochRejected"
      ]
    },
    {
      "op": "abortSnapshotUpload",
      "method": "DELETE",
      "path": "/vaults/{vault_id}/snapshots/{snapshot_id}/uploads",
      "auth": "account/device",
      "success": "200",
      "errors": [
        "VaultNotFound"
      ]
    }
  ],
